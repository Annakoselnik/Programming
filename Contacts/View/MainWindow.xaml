<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:View.Controls"
        xmlns:converters="clr-namespace:View.Converters"
        mc:Ignorable="d"
        Title="Контакты" Height="450" Width="600">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <DataTemplate x:Key="ContactItemTemplate">
            <StackPanel Margin="5">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="{Binding PhoneNumber}" FontSize="12" Foreground="Gray"/>
            </StackPanel>
        </DataTemplate>

        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="LightBlue"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="5" Tag="Фильтр..."/>

            <ListBox Grid.Row="1" 
                     ItemsSource="{Binding FilteredContactsView}"
                     SelectedItem="{Binding SelectedContact}"
                     ItemTemplate="{StaticResource ContactItemTemplate}"
                     Margin="5"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,10" Width="183">
                <Button Content="Add" Command="{Binding AddCommand}" Margin="5" Width="50" Height="20"/>
                <Button Content="Edit" Command="{Binding EditCommand}" Margin="5" Width="50" Height="20"/>
                <Button Content="Remove" Command="{Binding RemoveCommand}" Margin="5" Width="50" Height="20"/>
            </StackPanel>
        </Grid>

        <!-- Правая панель с ContactControl -->
        <Grid Grid.Column="1" 
              IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:ContactControl Grid.Row="0" DataContext="{Binding CurrentContact}"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5"
                        Visibility="{Binding ApplyVisibility, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Content="Apply" Command="{Binding ApplyCommand}" Margin="5" Width="70"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="5" Width="70"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
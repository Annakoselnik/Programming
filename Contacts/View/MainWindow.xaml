<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View.ViewModel"
        xmlns:conv="clr-namespace:View.Converters"
        mc:Ignorable="d"
        Title="Contacts" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="250"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0 0 3 0" Background="#F8F8F8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <Label Content="Find:" Margin="0,0,0,3" Padding="0"/>
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,3"/>
                </StackPanel>

                <ListBox Grid.Row="1" 
                     ItemsSource="{Binding FilteredContactsView}" 
                     SelectedItem="{Binding SelectedContact}"
                     DisplayMemberPath="Name"
                     Margin="0,0,0,8"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                
                <WrapPanel Grid.Row="2" HorizontalAlignment="Stretch">
                    <Button Content="Add" Command="{Binding AddCommand}" 
                            Height="25" Margin="0,0,3,0" MinWidth="60"/>
                    <Button Content="Edit" Command="{Binding EditCommand}"
                            Height="25" Margin="0,0,3,0" MinWidth="60"/>
                    <Button Content="Remove" Command="{Binding RemoveCommand}"
                            Height="25" Margin="0,0,3,0" MinWidth="60"/>
                </WrapPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="White"/>

        <Border Grid.Column="2" Background="White">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Top">
                    <Border Width="100" Height="100" Background="LightGray" CornerRadius="10">
                        <TextBlock Text="No photo" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="Gray" FontSize="10"/>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Name:" Margin="0,0,0,3"/>
                    <TextBox Grid.Row="1"
                     Text="{Binding CurrentName, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}"
                     Margin="0,0,0,3"/>

                    <Label Grid.Row="2" Content="Phone Number:" Margin="0,0,0,3"/>
                    <TextBox Grid.Row="3"
                     Text="{Binding CurrentPhone, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}"
                     Margin="0,0,0,3"/>

                    <Label Grid.Row="4" Content="Email:" Margin="0,0,0,3"/>
                    <TextBox Grid.Row="5"
                     Text="{Binding CurrentEmail, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}"
                     Margin="0,0,0,3"/>

                    <Button Grid.Row="6"
                    Content="Apply" Margin="0,3,0,0" Command="{Binding ApplyCommand}"
                    Width="75" Height="25" HorizontalAlignment="Left" 
                    Visibility="{Binding ApplyVisibility, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>